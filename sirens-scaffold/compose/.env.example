# ----------------------------------------------------------------------------
# Sirens — knowledge spine .env example
# Copy to .env and replace every CHANGE_ME before launching the compose stack.
# ----------------------------------------------------------------------------

# ---- Shared ----
TZ=UTC

# ---- OpenCTI ----
OPENCTI_ADMIN_EMAIL=admin@opencti.io
OPENCTI_ADMIN_PASSWORD=CHANGE_ME
OPENCTI_ADMIN_TOKEN=CHANGE_ME_UUID_v4
OPENCTI_BASE_URL=http://localhost:8080

# ---- Elasticsearch (shared by OpenCTI, TheHive, Cortex) ----
ELASTIC_VERSION=8.13.4
ELASTIC_PASSWORD=CHANGE_ME
ES_JAVA_OPTS=-Xms2g -Xmx2g

# ---- MinIO (S3 store for OpenCTI) ----
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGE_ME

# ---- RabbitMQ (OpenCTI worker bus) ----
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# ---- Redis (OpenCTI write log) ----
REDIS_PASSWORD=CHANGE_ME

# ---- MISP ----
MISP_BASE_URL=https://localhost
MISP_ADMIN_EMAIL=admin@admin.test
MISP_ADMIN_PASSWORD=CHANGE_ME
MISP_ADMIN_KEY=CHANGE_ME_40CHAR_ALNUM
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# ---- TheHive ----
THEHIVE_ADMIN_EMAIL=admin@thehive.local
THEHIVE_ADMIN_PASSWORD=CHANGE_ME
THEHIVE_SECRET=CHANGE_ME_64CHAR_RANDOM

# ---- Cortex ----
CORTEX_SECRET=CHANGE_ME_64CHAR_RANDOM

# ---- SpiderFoot ----
SPIDERFOOT_URL=http://spiderfoot:5001
SPIDERFOOT_USER=
SPIDERFOOT_PASSWORD=

# ---- Velociraptor ----
# Absolute path to api.config.yaml generated by `velociraptor config api_client`
VELOCIRAPTOR_CONFIG_PATH=./secrets/velociraptor-api.config.yaml
